{
  "name": "surveyplatformfrontend",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.4.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:eyetracking": "vitest run tests/eyetracking",
    "typecheck:eyetracking": "tsc -p tsconfig.eyetracking.json",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@craftjs/core": "^0.2.12",
    "@marsidev/react-turnstile": "^1.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "axios": "^1.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.58.2",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vitest": "4.1.11"
  }
}
