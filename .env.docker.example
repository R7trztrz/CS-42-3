POSTGRES_DB=survey_platform
POSTGRES_USER=survey_user
POSTGRES_PASSWORD=survey_password

# Base64 value for a development JWT secret. Replace it for real deployment.
JWT_SECRET=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Cloudflare Turnstile secret and site key.
TURNSTILE_SECRET=your-turnstile-secret
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Browser-facing backend URL.
VITE_API_BASE_URL=http://localhost:8080

# Browser-facing URL used in participant links.
APP_PARTICIPANT_BASE_URL=http://localhost:5173

# Use the integrated M6 completion gate. dev/test explicitly bypass it.
SPRING_PROFILES_ACTIVE=default
