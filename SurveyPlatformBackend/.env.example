# Copy this file to .env and replace all values with your local settings.
# Configure IntelliJ to load .env; Spring Boot does not load it automatically.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/example_database
SPRING_DATASOURCE_USERNAME=example_user
SPRING_DATASOURCE_PASSWORD=replace-with-local-password
JWT_SECRET=replace-with-a-base64-encoded-secret
TURNSTILE_SECRET=your-turnstile-secret
# Frontend origin or deployment base path; the backend appends /participate/{token}.
APP_PARTICIPANT_BASE_URL=http://localhost:5173
