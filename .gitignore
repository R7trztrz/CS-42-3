# Ignore all entries in the repository root by default.
/*

# Keep the root ignore rules and project README under version control.
!/.gitignore
!/README.md
!/docker-compose.yml
!/.env.docker.example

# Allow the application directories; their own ignore rules still apply.
!/SurveyPlatformBackend/
!/SurveyPlatformFrontend/

# GitHub Actions workflows
!/.github/
!/.github/workflows/
!/.github/workflows/*.yml

# Track server deployment configuration and environment template
!/docker-compose.server.yml
!/.env.server.example

# Track the server deployment guide
!/Server_Deployment_Guide.md